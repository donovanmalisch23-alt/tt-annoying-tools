# systemd unit for Simple TT Media.
# Copy to /etc/systemd/system/simple-tt-media.service and edit the paths,
# user, and secrets below. Then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now simple-tt-media

[Unit]
Description=Simple TT Media - TeamTalk media player bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# The account the bot runs as (create a dedicated, unprivileged user).
User=ttmedia
Group=ttmedia

# Absolute path to the project directory (contains config.toml).
WorkingDirectory=/opt/simple_tt_media

# Secrets: prefer env vars over putting them in config.toml.
# Keep this drop-in file mode 600 since it holds credentials.
Environment=TT_PASSWORD=change-me
# Environment=SPOTIFY_CLIENT_ID=...
# Environment=SPOTIFY_CLIENT_SECRET=...
# Environment=TEAMTALK_SDK=/opt/teamtalk-sdk

# Use the project's virtualenv python if you created one.
ExecStart=/usr/bin/python3 -m ttmedia --config /opt/simple_tt_media/config.toml

Restart=on-failure
RestartSec=5

# Light hardening (loosen if your setup needs more access).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target

__pycache__/
*.py[cod]
*.log
.DS_Store

# Local SDK/server credentials and machine-specific paths.
teamtalk.env
whitelist.txt

# Per-user first-run SDK license acceptance marker.
.tt-sdk-license-accepted

# Local development environments.
.venv/
venv/
env/

# Local terminal-session captures and shell prompt state (not source).
typescript
.change-ip-state

# Web panel (Vite + React PWA).
node_modules/
dist/
.vite/
*.tsbuildinfo

# Webby bridge state: pid file, log, and the admin credential hash.
.webby/

# Android panel wrapper (android-panel/): the built panel is copied into the
# APK's assets by `bun run android:assets`, so it is generated, not source.
android-panel/app/src/main/assets/panel/*
!android-panel/app/src/main/assets/panel/.gitkeep
android-panel/build/
android-panel/app/build/
android-panel/.gradle/
android-panel/local.properties
android-panel/keystore/
*.apk

# Native Android app (android/): the TeamTalk 5 SDK is not redistributed here.
# Drop TeamTalk5.jar and the per-ABI libTeamTalk5-jni.so in locally (see
# android/README.md) and everything it adds stays out of git.
android/app/libs/*.jar
android/app/libs/*.aar
android/app/src/main/jniLibs/**
!android/app/src/main/jniLibs/**/README.md
android/app/build/
android/.gradle/
# The app copies sdk/License.txt into its assets at build time, so there is no
# second copy of the license text in git.
android/app/src/main/assets/teamtalk-sdk-license.txt
android/local.properties
android/gradle/wrapper/gradle-wrapper.jar
android/*.keystore

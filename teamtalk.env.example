# Copy this file to teamtalk.env and edit the SDK paths and credentials.
# Exported shell variables take precedence over these defaults.

TEAMTALK_SDK_PYTHON=sdk/TeamTalk5.py
TEAMTALK_SDK_LIBRARY=sdk/libTeamTalk5.so

TT_HOST=127.0.0.1
TT_TCP_PORT=10333
TT_UDP_PORT=10333
# Leave both blank for servers that accept anonymous logins (no user
# accounts); blank is also the built-in default when these are unset.
TT_USERNAME=
TT_PASSWORD=
TT_NICKNAME=tt-api-client
TT_CLIENT_NAME=TT Annoying Tools Linux API
TT_ENCRYPTED=false
TT_CHANNEL_PATH=/LoadTest
TT_CHANNEL_PASSWORD=
TT_COMMAND_TIMEOUT=15

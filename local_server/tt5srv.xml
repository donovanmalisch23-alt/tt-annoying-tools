<?xml version="1.0" encoding="UTF-8" ?>
<!-- Local-only TeamTalk5 server for this repository. -->
<teamtalk version="5.0">
    <general>
        <server-name>TT Annoying Tools local</server-name>
        <motd>local TeamTalk API test server</motd>
        <max-users>100</max-users>
        <auto-save>false</auto-save>
        <bind-ip>127.0.0.1</bind-ip>
        <tcpport>10333</tcpport>
        <udpport>10333</udpport>
        <upnp>false</upnp>
        <login-attempts>0</login-attempts>
        <max-logins-per-ipaddr>0</max-logins-per-ipaddr>
        <bandwidth-limits>
            <voicetx-limit>0</voicetx-limit>
            <vidcaptx-limit>0</vidcaptx-limit>
            <mediafiletx-limit>0</mediafiletx-limit>
            <desktoptx-limit>0</desktoptx-limit>
            <totaltx-limit>0</totaltx-limit>
        </bandwidth-limits>
        <user-timeout>60</user-timeout>
    </general>
    <file-storage>
        <files-root>.</files-root>
        <max-diskusage>512000000</max-diskusage>
        <channel-diskquota>51200000</channel-diskquota>
    </file-storage>
    <logging>
        <server-log-maxsize>-1</server-log-maxsize>
    </logging>
    <users>
        <user>
            <username>loadtest</username>
            <password>loadtest</password>
            <user-type>1</user-type>
            <user-rights>259591</user-rights>
            <note />
            <userdata>0</userdata>
            <init-channel />
            <audiocodec-bps-limit>0</audiocodec-bps-limit>
            <channel-operator />
        </user>
        <user>
            <username>loadadmin</username>
            <password>loadadmin</password>
            <user-type>2</user-type>
            <user-rights>0</user-rights>
            <note />
            <userdata>0</userdata>
            <init-channel />
            <audiocodec-bps-limit>0</audiocodec-bps-limit>
            <channel-operator />
        </user>
    </users>
    <permanent-channels>
        <channel>
            <!-- Channel path: / -->
            <channel-id>1</channel-id>
            <password />
            <topic />
            <diskquota>0</diskquota>
            <op-password />
            <max-users>1000</max-users>
            <channel-type>1</channel-type>
            <userdata>0</userdata>
            <audio-codec>
                <codec-type>3</codec-type>
                <samplerate>48000</samplerate>
                <channels>1</channels>
                <application>2048</application>
                <complexity>10</complexity>
                <fec>true</fec>
                <dtx>false</dtx>
                <bitrate>32000</bitrate>
                <vbr>true</vbr>
                <vbr-constraint>false</vbr-constraint>
                <framesize>1920</framesize>
            </audio-codec>
            <audio-config>
                <enable-agc>false</enable-agc>
                <gain-level>0</gain-level>
            </audio-config>
            <channel>
                <!-- Channel path: /LoadTest/ -->
                <channel-id>2</channel-id>
                <name>LoadTest</name>
                <password />
                <topic>local API test channel</topic>
                <diskquota>0</diskquota>
                <op-password />
                <max-users>1000</max-users>
                <channel-type>1</channel-type>
                <userdata>0</userdata>
                <audio-codec>
                    <codec-type>3</codec-type>
                    <samplerate>48000</samplerate>
                    <channels>1</channels>
                    <application>2048</application>
                    <complexity>10</complexity>
                    <fec>true</fec>
                    <dtx>false</dtx>
                    <bitrate>32000</bitrate>
                    <vbr>true</vbr>
                    <vbr-constraint>false</vbr-constraint>
                    <framesize>1920</framesize>
                </audio-codec>
                <audio-config>
                    <enable-agc>false</enable-agc>
                    <gain-level>0</gain-level>
                </audio-config>
            </channel>
        </channel>
    </permanent-channels>
</teamtalk>
